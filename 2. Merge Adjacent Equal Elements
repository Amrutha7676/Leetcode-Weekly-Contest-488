class Solution {
    public List<Long> mergeAdjacent(int[] nums) {
         List<Long> list = new ArrayList<>();

        for (int num : nums) {
            list.add((long) num);

            // Keep merging while last two are equal
            while (list.size() >= 2) {
                int size = list.size();
                long last = list.get(size - 1);
                long secondLast = list.get(size - 2);

                if (last == secondLast) {
                    list.remove(size - 1);
                    list.remove(size - 2);
                    list.add(last + secondLast);
                } else {
                    break;
                }
            }
        }

        return list;
    }
}
