class Solution {
    public int dominantIndices(int[] nums) {
      int n = nums.length;
        if (n <= 1) return 0;

        int totalSum = 0;
        for (int num : nums) {
            totalSum += num;
        }

        int count = 0;
        int remainingSum = totalSum;

        for (int i = 0; i < n - 1; i++) {
            remainingSum -= nums[i];  // sum of right side
            int remainingCount = n - i - 1;

            if (nums[i] * remainingCount > remainingSum) {
                count++;
            }
        }

        return count;
      
    }
}
